// CICS E-Clearance — Task 1 (Auth & User Management)
// Schema kept narrow: only tables Task 1 needs. Tasks 2–6 will extend it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Supabase: pooled connection (port 6543, pgbouncer) for the app.
  url       = env("DATABASE_URL")
  // Supabase: direct connection (port 5432) for migrations.
  directUrl = env("DIRECT_URL")
}

enum Role {
  student
  bytes_officer
  librarian
  faculty_adviser
  chairperson
  dean
}

enum AccountStatus {
  pending
  approved
  denied
}

model User {
  id              String        @id @default(uuid())
  schoolId        String        @unique @map("school_id")
  role            Role          @default(student)
  firstName       String        @map("first_name")
  middleName      String?       @map("middle_name")
  lastName        String        @map("last_name")
  sex             String?
  birthdate       DateTime?
  email           String        @unique
  contactNumber   String?       @map("contact_number")
  course          String?
  college         String?
  department      String?
  passwordHash    String        @map("password_hash")
  status          AccountStatus @default(pending)
  approvedById    String?       @map("approved_by_id")
  approvedAt      DateTime?     @map("approved_at")
  denialReason    String?       @map("denial_reason")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  payments        Payment[]

  approvedBy      User?         @relation("UserApprovals", fields: [approvedById], references: [id])
  approvedUsers   User[]        @relation("UserApprovals")

  clearanceRequests ClearanceRequest[]
  decidedStages     ClearanceStage[]   @relation("StageApprover")

  @@map("users")
}

// --- Task 2: Student Clearance Request ---

enum ClearanceStatus {
  pending
  approved
  denied
  completed
}

// Approval stages a clearance passes through, in order.
enum StageRole {
  bytes_officer
  librarian
  faculty_adviser
  chairperson
  dean
}

enum StageStatus {
  pending
  approved
  denied
}

model ClearanceRequest {
  id           String           @id @default(uuid())
  studentId    String           @map("student_id")
  referenceNo  String           @unique @map("reference_no")
  academicYear String           @map("academic_year")
  status       ClearanceStatus  @default(pending)
  createdAt    DateTime         @default(now()) @map("created_at")
  completedAt  DateTime?        @map("completed_at")

  student      User             @relation(fields: [studentId], references: [id])
  stages       ClearanceStage[]

  @@map("clearance_requests")
}

model ClearanceStage {
  id                 String           @id @default(uuid())
  clearanceRequestId String           @map("clearance_request_id")
  role               StageRole
  status             StageStatus      @default(pending)
  approverId         String?          @map("approver_id")
  reason             String?
  decidedAt          DateTime?        @map("decided_at")
  createdAt          DateTime         @default(now()) @map("created_at")

  request            ClearanceRequest @relation(fields: [clearanceRequestId], references: [id], onDelete: Cascade)
  approver           User?            @relation("StageApprover", fields: [approverId], references: [id])

  @@unique([clearanceRequestId, role])
  @@map("clearance_stages")
}

// --- Task 4: Payments (fines & fees) ---

model Fine {
  id        String   @id @default(uuid())
  studentId String
  amount    Float
  reason    String
  status    String   // unpaid / paid
  createdAt DateTime @default(now())
}

model Fee {
  id        String   @id @default(uuid())
  name      String
  amount    Float
}

model Payment {
  id          String   @id @default(uuid())
  userId      String
  type        String   // fine / fee
  amount      Float
  method      String   // gcash / onsite
  receipt     String?  // file path
  status      String   // pending / approved / rejected
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
