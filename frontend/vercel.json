{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "node ../scripts/inject-backend-url.mjs && npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://BACKEND_URL_PLACEHOLDER/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://BACKEND_URL_PLACEHOLDER/uploads/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
