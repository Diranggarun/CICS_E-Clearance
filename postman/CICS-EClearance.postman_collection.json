          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{bytes_token}}" }],
            "url": "{{base_url}}/api/admin/students"
          }
        },
        {
          "name": "GET /api/admin/reports/clearance",
          "event": [
            {
              "listen": "test",
